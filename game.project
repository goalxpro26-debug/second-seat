[project]
title = Second Seat
version = 1.0.0

[bootstrap]
main_collection = /main/main.collectionc

[input]
game_binding = /input/game.input_bindingc
use_accelerometer = 0

[display]
width = 1136
height = 640
high_dpi = 1

[script]
shared_state = 1

[physics]
gravity_y = -1000.0
scale = 0.01
velocity_threshold = 100.0

[html5]
scale_mode = stretch
show_fullscreen_button = 0
show_made_with_defold = 0

[library]
include_dirs = gamedistribution

[gamedistribution]
game_id = PLACEHOLDER
